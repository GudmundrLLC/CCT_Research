# Postgres connection string (on Railway: reference ${{Postgres.DATABASE_URL}})
DATABASE_URL=postgresql://postgres@localhost:5432/cct
# Shared lab passcode: enrolls a Gudmundr (Gateway) account into the lab once,
# and remains a fallback sign-in until every member has linked their account
LAB_PASSCODE=change-me
# Gudmundr Gateway (ecosystem sign-in + DDUUI chrome); defaults to production
GATEWAY_URL=https://gateway.gudmundr.com
# Optional: emails let in through Gateway without the passcode step (comma-separated)
LAB_MEMBER_EMAILS=
# Optional: public origin used for the SSO callback (defaults to the request host)
APP_PUBLIC_URL=
# AI: granite (default, runs in-app, free) | claude (needs ANTHROPIC_API_KEY) | off
AI_PROVIDER=granite
GRANITE_MODEL=onnx-community/granite-4.0-1b-ONNX-web
GRANITE_DTYPE=q4
# GRANITE_CACHE=/data/models   # defaults to $RAILWAY_VOLUME_MOUNT_PATH/models or .cache/models
ANTHROPIC_API_KEY=
# Optional: separate cookie-signing secret (defaults to one derived from LAB_PASSCODE)
SESSION_SECRET=
